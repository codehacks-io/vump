# What building something produces, wherever it is built: the sandbox, the
# website, and the project files kept as test fixtures. Scoped by what the
# output is rather than by where it sits, because the same output appears
# wherever someone runs the tool that makes it.
**/target/
**/obj/
**/bin/
# Cargo's convention for extra binaries, which the rule above would hide.
!src/bin/
**/node_modules/
**/.venv/
**/__pycache__/
dist/

.DS_Store

# Personal, machine-local agent settings
.claude/settings.local.json
.claude/launch.json
